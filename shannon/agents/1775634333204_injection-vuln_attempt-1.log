le\\\": true,\\n      \\\"source\\\": \\\"req.query.tag_filter — GET /api/gigs?tag_filter= (gigs.controller.js:10)\\\",\\n      \\\"combined_sources\\\": \\\"Single source: req.query.tag_filter\\\",\\n      \\\"path\\\": \\\"gigs.routes.js:8 (public, optionalAuth) → gigs.controller.js:10 (pass req.query to service) → gigs.service.js:19 (destructure tag_filter) → gigs.service.js:41-46 (MongoDB $where template literal sink)\\\",\\n      \\\"sink_call\\\": \\\"src/gigs/gigs.service.js:41-46 — MongoDB $where operator with template literal JavaScript function body; gigs.service.js:95-101 — Gig.find(query)\\\",\\n      \\\"slot_type\\\": \\\"TEMPLATE-expression\\\",\\n      \\\"sanitization_observed\\\": \\\"None\\\",\\n      \\\"concat_occurrences\\\": \\\"gigs.service.js:44 — template literal `return ${tag_filter};` embeds user input as executable JavaScript inside $where function body\\\",\\n      \\\"verdict\\\": \\\"vulnerable\\\",\\n      \\\"mismatch_reason\\\": \\\"tag_filter is embedded verbatim as the return expression of a MongoDB $where JavaScript function. Any valid JavaScript expression is accepted, enabling arbitrary logic bypass and MongoDB server-side JS execution. No sanitization, escaping, or allowlist applied.\\\",\\n      \\\"witness_payload\\\": \\\"true || (function(){return true;})()\\\",\\n      \\\"confidence\\\": \\\"med\\\",\\n      \\\"notes\\\": \\\"MongoDB 7 disables $where / javascriptEnabled by default. Verify mongod.conf for javascriptEnabled:true in this deployment before investing exploitation resources. If disabled, $where will be rejected at the MongoDB layer. All other gig filter params (category, tags, min_price, max_price, sort, page, limit) are SAFE and use proper Mongoose operators or type casts.\\\"\\n    },\\n    {\\n      \\\"ID\\\": \\\"INJ-VULN-04\\\",\\n      \\\"vulnerability_type\\\": \\\"SQLi\\\",\\n      \\\"externally_exploitable\\\": true,\\n      \\\"source\\\": \\\"req.query.usernames (comma-separated string, split to array) — GET /api/admin/reports/activity?usernames= (admin.controller.js:244,251)\\\",\\n      \\\"combined_sources\\\": \\\"Single source: req.query.usernames (split on comma at admin.controller.js:251)\\\",\\n      \\\"path\\\": \\\"admin.routes.js:25 (requireAdmin — bypassable via forged JWT) → admin.controller.js:244 (extract) → admin.controller.js:251 (split+trim only) → admin.service.js:360 (quote-wrap each element) → admin.service.js:361 (JSON string concat) → admin.service.js:362 (JSON.parse materializes as live query object) → admin.service.js:371 (ActivityLog.find sink)\\\",\\n      \\\"sink_call\\\": \\\"src/admin/admin.service.js:361-362 — manual JSON string construction + JSON.parse(); src/admin/admin.service.js:371 — ActivityLog.find(filter)\\\",\\n      \\\"slot_type\\\": \\\"DESERIALIZE-object\\\",\\n      \\\"sanitization_observed\\\": \\\"None (quote-wrapping with double-quotes at line 360 provides no protection — username value can contain unescaped double-quote characters breaking JSON structure)\\\",\\n      \\\"concat_occurrences\\\": \\\"admin.service.js:360 — '\\\\\\\"' + u + '\\\\\\\"' (no JSON character escaping of u); admin.service.js:361 — userFilter string concatenated into JSON template literal\\\",\\n      \\\"verdict\\\": \\\"vulnerable\\\",\\n      \\\"mismatch_reason\\\": \\\"The quote-wrapping at line 360 assumes username values do not contain double-quote characters. An attacker injects a username containing embedded quotes and MongoDB operator syntax that breaks out of the $in array. JSON.parse() at line 362 materializes the attacker-controlled structure as a live MongoDB filter object, enabling arbitrary operator injection.\\\",\\n      \\\"witness_payload\\\": \\\"alice\\\\\\\",\\\\\\\"$or\\\\\\\":[{\\\\\\\"metadata.username\\\\\\\":{\\\\\\\"$ne\\\\\\\":null}}],\\\\\\\"x\\\\\\\":\\\\\\\"a\\\",\\n      \\\"confidence\\\": \\\"high\\\",\\n      \\\"notes\\\": \\\"Requires admin role. Bypass via forged JWT with secret hireflow2