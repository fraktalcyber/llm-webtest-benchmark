trip() for u in usernames_raw.split(\",\")]\n    user_filter = \",\".join(f'\"{u}\"' for u in username_list)\n    assembled = '{ \"metadata.username\": { \"$in\": [' + user_filter + '] } }'\n    print(f\"  Assembled query string (server-side):\")\n    print(f\"    {assembled}\")\n    try:\n        parsed = json.loads(assembled)\n        print(f\"  Parsed successfully: {json.dumps(parsed)}\")\n    except json.JSONDecodeError as e:\n        print(f\"  JSON parse error (will 500): {e}\")\n\n    # URL-encode and fire request\n    encoded = urlencode(params)\n    url = f\"{TARGET}?{encoded}\"\n    print(f\"\\n  Request URL: {url[:200]}{'...' if len(url) > 200 else ''}\")\n\n    try:\n        response = requests.get(url, headers=HEADERS, timeout=15)\n        print(f\"\\n  Status Code : {response.status_code}\")\n\n        try:\n            body = response.json()\n        except ValueError:\n            print(f\"  Response (raw): {response.text[:500]}\")\n            return\n\n        # Extract total\n        total = None\n        if isinstance(body, dict):\n            for loc in (body, body.get(\"report\", {})):\n                for key in (\"total\", \"count\", \"totalLogs\", \"totalCount\"):\n                    if isinstance(loc, dict) and key in loc:\n                        total = loc[key]\n                        break\n                if total is not None:\n                    break\n        print(f\"  Total        : {total}\")\n\n        # Extract entries\n        entries = None\n        for loc in (body, body.get(\"report\", {})):\n            if isinstance(loc, dict):\n                for key in (\"entries\", \"logs\", \"data\", \"results\", \"activities\"):\n                    if key in loc and isinstance(loc[key], list) and len(loc[key]) > 0:\n                        entries = loc[key]\n                        break\n            if entries:\n                break\n        if isinstance(body, list) and len(body) > 0:\n            entries = body\n\n        if