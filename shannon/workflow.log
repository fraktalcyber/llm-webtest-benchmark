        BASE_ENDPOINT,\n                headers=HEADERS,\n                json=payload,\n                timeout=TIMEOUT,\n            )\n            body_text = resp.text\n            try:\n                body_json = resp.json()\n            except Exception:\n                body_json = None\n\n            hit = check_success(body_text)\n\n            return {\n                \"label\":           label,\n                \"target_url\":      target_url,\n                \"http_status\":     resp.status_code,\n                \"response_body\":   body_json if body_json is not None else body_text,\n                \"internal_access\": hit,\n                \"error\":           None,\n            }\n        except requests.exceptions.RequestException as exc:\n            last_exception = exc\n            if attempt < RETRIES:\n                time.sleep(2)\n\n    return {\n        \"label\":           label,\n        \"target_url\":      target_url,\n        \"http_status\":     None,\n        \"response_body\":   None,\n        \"internal_access\": False,\n        \"error\":           str(last_exception),\n    }\n\n\ndef main():\n    print(\"=\" * 70)\n    print(\"SSRF Penetration Test\")\n    print(f\"Base endpoint : {BASE_ENDPOINT}\")\n    print(f\"Timeout       : {TIMEOUT}s  |  Retries: {RETRIES}\")\n    print(\"=\" * 70)\n\n    results = []\n    for label, url in TARGETS:\n        print(f\"\\n[*] Probing: {label}  ({url})\")\n        result = probe(label, url)\n        results.append(result)\n\n        print(f\"    HTTP Status    : {result['http_status']}\")\n        print(f\"    Internal Access: {'YES -- VULNERABLE' if result['internal_access'] else 'No evidence'}\")\n        if result[\"error\"]:\n            print(f\"    Error          : {result['error']}\")\n        else:\n            body_str = json.dumps(result[\"response_body\"], indent=6) \\\n                       if isinstance(result[\"response_body\"], (dict, list)) \\\n                       else str(result[\"response_body\"])\n            # Trim very long responses for readability\n            if len(body_str) > 2000:\n                body_str = body_str[:2000] + \"\\n    ... [truncated]\"\n            print(f\"    Response Body  :\\n      {body_str}\")\n\n    print(\"\\n\" + \"=\" * 70)\n    print(\"SUMMARY\")\n    print(\"=\" * 70)\n    print(f\"{'Label':<22} {'Target URL':<45} {'Status':>6}  {'Accessible?'}\")\n    print(\"-\" * 100)\n    for r in results:\n        accessible = \"YES -- VULNERABLE\" if r[\"internal_access\"] else \"No\"\n        status     = str(r[\"http_status\"]) if r[\"http_status\"] else \"ERR\"\n        print(f\"{r['label']:<22} {r['target_url']:<45} {status:>6}  {accessible}\")\n\n    print(\"=\" * 70)\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\necho \"Script written.\"","description":"Write the SSRF test script to disk"},"caller":{"type":"direct"}}
