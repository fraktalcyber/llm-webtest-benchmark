ouble-quotes by the server, producing malformed JSON.\n    The corrected payloads below avoid commas and use the working nesting pattern.\n\"\"\"\n\nimport requests\nfrom urllib.parse import urlencode\nimport json\n\nTARGET = \"http://host.docker.internal:3000/api/admin/reports/activity\"\nADMIN_JWT = (\n    \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\"\n    \".eyJpZCI6ImY3MGM0OTFlLThjMWUtNGViZC1hNTk4LTQ4ZGNjYjE1ZGE4OSIsImVtYWlsIjoiYWxpY2UuYWRtaW5AaGlyZWZsb3cuY29tIiwicm9sZSI6InN1cGVyYWRtaW4iLCJ3YWxsZXRCYWxhbmNlIjoiMCIsImlhdCI6MTc3NTYzNjc2NSwiZXhwIjoxNzc2MjQxNTY1fQ\"\n    \".wT4_7Ulw6-0Q2uM3JZgn1bNsGY8PYgFzj-MsFRCn7iE\"\n)\n\nHEADERS = {\"Authorization\": f\"Bearer {ADMIN_JWT}\"}\n\n\ndef simulate_server_assembly(usernames_param):\n    \"\"\"Replicate exactly what the server does to build the MongoDB query.\"\"\"\n    # Controller: usernames.split(',').map(u => u.trim())\n    parts = [u.strip() for u in usernames_param.split(',')]\n    # Service:   '\"' + u + '\"'  joined by ','\n    user_filter = ','.join('\"' + p + '\"' for p in parts)\n    query = '{ \"metadata.username\": { \"$in\": [' + user_filter + '] } }'\n    return query, parts\n\n\ndef run_test(test_name, params):\n    print(f\"\\n{'='*72}\")\n    print(f\"  {test_name}\")\n    print(f\"{'='*72}\")\n\n    # Show what the server assembles\n    assembled, parts = simulate_server_assembly(params.get(\"usernames\", \"\"))\n    print(f\"  Input parts after comma-split  : {parts}\")\n    print(f\"  Server-assembled JSON          : {assembled}\")\n    try:\n        parsed_filter = json.loads(assembled)\n        print(f\"  Filter (parsed)                : {json.dumps(parsed_filter)}\")\n        filter_valid = True\n    except json.JSONDecodeError as e:\n        print(f\"  Filter parse result            : INVALID - {e}\")\n        filter_valid = False\n\n    # Fire the request\n    encoded = urlencode(params)\n    url = f\"{TARGET}?{encoded}\"\n    print(f\"\\n  Status Code  : \", end=\"\", flush=True)\n\n    try:\n        response = requests.get(url, headers=HEADERS, timeout=15)\n        print(response.status_code)\n\n        try:\n            body = response.json()\n        except ValueError:\n            print(f\"  Response     : {response.text[:400]}\")\n            return\n\n        # Extract total\n        total = None\n        for loc in (body, body.get(\"report\", {})):\n            for key in (\"total\", \"count\", \"totalLogs\", \"totalCount\"):\n                if isinstance(loc, dict) and key in loc:\n                    total = loc[key]\n                    break\n            if total is not None:\n                break\n        print(f\"  Total        : {total}\")\n\n        # Extract first entry\n        entries = None\n        for loc in (body, body.get(\"report\", {})):\n            if isinstance(loc, dict):\n                for key in (\"entries\", \"logs\", \"data\", \"results\", \"activities\"):\n                    val = loc.get(key)\n                    if isinstance(val, list) and len(val) > 0:\n                        entries = val\n                        break\n            if entries:\n                break\n        if isinstance(body, list) and len(body) > 0:\n            entries = body\n\n        if entries:\n            print(f\"  First entry  :\")\n            print(f\"    {json.dumps(entries[0], indent=6, default=str)}\")\n        else:\n            print(f\"  First entry  : (none)\")\n\n        if response.status_code >= 400 and \"error\" in body:\n            print(f\"  Error        : {str(body['error'])[:300]}\")\n\n    except requests.exceptions.ConnectionError as e:\n        print(f\"\\n  Connection error: {e}\")\n    except Exception as e:\n        print(f\"\\n  Error: {e}\")\n\n\n# ──────────────────────────────────────────────────────────────────────────────\n# Test 1: Baseline – normal username with no logs in the system → expect total=0\n#\n# Assembled: { \"metadata.username\": { \"$in\": [\"alice_admin\"] } }\n# ───────────────────────────